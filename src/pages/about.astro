---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/me/portrait.jpg';
import SkillGrid from '../components/SkillGrid.astro';
import cv from '../data/cv.json';

const coursework = ['Big Data Systems', 'Honors Algorithms', 'Databases', 'Artificial Intelligence', 'Machine Learning', 'Machine Organization'];

// Experience and projects come from the CV master (Job Applications/cv/master.yaml) through
// cv/sync_site.sh, so this page and the CV always say the same thing.
const { experience, projects } = cv;
---

<Base title="About" description="Vinith Ramaswamy: software engineer in San Jose. B.S. Computer Science and B.S. Data Science from UW–Madison, GPA 3.96. Founder and sole engineer of JustBook.">
  <section class="top">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap head">
      <div>
      <span class="eyebrow" data-reveal>About</span>
      <h1 data-reveal style="--d:80ms">Vinith Ramaswamy</h1>
      <div class="intro" data-reveal style="--d:160ms">
        <p>
          Software engineer based in San Jose, CA. I graduated from the University of Wisconsin–Madison in May 2026 with
          degrees in Computer Science and Data Science. While there I founded <a href="/projects/justbook/">JustBook</a> and
          built it alone, from the data model to the mobile apps to operations.
        </p>
        <p>
          I'm looking for a software engineering role in the Bay Area: backend, platform, payments or full stack. U.S.
          permanent resident, no sponsorship needed.
        </p>
      </div>
      <div class="actions" data-reveal style="--d:220ms">
        <a class="btn primary" href="/Vinith_Ramaswamy_CV.pdf" target="_blank" rel="noopener">Download CV <span class="arrow" aria-hidden="true">↓</span></a>
        <a class="btn" href="https://www.linkedin.com/in/vinithramaswamy" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
        <a class="btn" href="https://github.com/vramaswamy4" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
        <a class="btn" href="mailto:vinithramaswamy@gmail.com">Email</a>
      </div>
      </div>
      <figure class="photo" data-reveal style="--d:200ms">
        <Image src={portrait} alt="Vinith Ramaswamy in a graduation cap and gown on Bascom Hill at UW–Madison" widths={[360, 560, 900]} sizes="(max-width: 860px) 70vw, 340px" loading="eager" />
        <figcaption>Graduation, UW–Madison · May 2026</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="label" data-reveal>Education</h2>
      <div class="edu" data-reveal>
        <div class="gpa">
          <div class="num"><strong>3.96</strong><span>/ 4.0</span></div>
          <div class="bar" role="img" aria-label="GPA 3.96 out of 4.0"><i></i></div>
          <p>Cumulative GPA</p>
        </div>
        <div class="detail">
          <h3>B.S. Computer Science<br />B.S. Data Science</h3>
          <p class="uni">University of Wisconsin–Madison · Aug 2023 – May 2026</p>
          <ul class="honors">
            <li>Graduated with Distinction</li>
            <li>Two degrees in three years</li>
            <li>Certificate in Entrepreneurship</li>
          </ul>
          <div class="chips">{coursework.map((c) => <span class="chip">{c}</span>)}</div>
          <a class="more" href="/coursework/">Every course, with grades and what each one taught me <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <h2 class="label" data-reveal>Experience</h2>
      <ol class="roles">
        {experience.map((e) => (
          <li data-reveal>
            <div class="side">
              <span class="when">{e.when}</span>
            </div>
            <div>
              <h3>{e.title} · {e.href ? <a href={e.href}>{e.org} <span aria-hidden="true">→</span></a> : e.org}</h3>
              <p class="note">{e.note}</p>
              <ul>{e.bullets.map((b) => <li><strong>{b.lead}</strong> {b.rest}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <h2 class="label" data-reveal>Projects</h2>
      <ol class="roles">
        {projects.map((p) => (
          <li data-reveal>
            <div class="side"><span class="when">{p.when}</span></div>
            <div>
              <h3>{p.href ? <a href={p.href} target={p.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{p.title} <span aria-hidden="true">→</span></a> : p.title}</h3>
              {p.subtitle && <p class="note">{p.subtitle}</p>}
              <ul>{p.bullets.map((b) => <li><strong>{b.lead}</strong> {b.rest}</li>)}</ul>
              {p.stack && <p class="stack">{p.stack}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section tight last">
    <div class="wrap">
      <h2 class="label" data-reveal>Skills</h2>
      <SkillGrid />
    </div>
  </section>
</Base>

<style>
  .top { position: relative; padding: clamp(130px, 17vw, 190px) 0 clamp(44px, 6vw, 72px); overflow: hidden; border-bottom: 1px solid var(--border); }
  .glow { position: absolute; inset: -30% -10% auto; height: 120%; background: radial-gradient(640px 360px at 20% 40%, color-mix(in srgb, var(--teal) 13%, transparent), transparent 70%); pointer-events: none; }
  .top .wrap { position: relative; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) clamp(240px, 26vw, 340px); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .photo { margin: 0; }
  .photo :global(img) { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 22px; border: 1px solid var(--border-strong); box-shadow: var(--shadow), 0 0 0 6px color-mix(in srgb, var(--teal) 10%, transparent); }
  .photo figcaption { margin-top: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); text-align: center; }
  @media (max-width: 860px) { .head { grid-template-columns: 1fr; } .photo { max-width: 300px; order: -1; } }
  h1 { font-size: clamp(44px, 7vw, 88px); letter-spacing: -0.045em; margin: 22px 0 30px; }
  .intro { max-width: 700px; font-size: 18.5px; color: var(--text-2); }
  .intro a { color: var(--text); border-bottom: 1px solid var(--teal); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .section.tight { padding-top: 0; }
  .section.last { padding-bottom: clamp(72px, 10vw, 128px); }
  .label { font-family: var(--font-mono); font-size: 13px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); margin-bottom: 26px; display: flex; align-items: center; gap: 14px; }
  .label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  .edu {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) 1.2fr;
    border: 1px solid var(--border-strong);
    border-radius: 24px;
    overflow: hidden;
    background: var(--bg-raise);
    box-shadow: var(--shadow);
  }
  .gpa {
    padding: clamp(30px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    background:
      radial-gradient(420px 260px at 10% 0%, color-mix(in srgb, var(--teal) 22%, transparent), transparent 72%),
      var(--surface);
    border-right: 1px solid var(--border);
  }
  .num { display: flex; align-items: baseline; gap: 14px; }
  .num strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(88px, 11vw, 148px);
    line-height: 0.86;
    letter-spacing: -0.06em;
    background: linear-gradient(120deg, var(--teal) 20%, color-mix(in srgb, var(--teal) 45%, var(--violet)) 95%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .num span { font-family: var(--font-mono); font-size: 17px; color: var(--muted); }
  .bar { height: 6px; border-radius: 99px; background: var(--border); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 99%; border-radius: inherit; background: linear-gradient(90deg, var(--teal), color-mix(in srgb, var(--teal) 50%, var(--violet))); transform-origin: left; animation: grow 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both; }
  @keyframes grow { from { transform: scaleX(0); } }
  .gpa p { margin: 0; font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .detail { padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; gap: 14px; justify-content: center; }
  .detail h3 { font-size: clamp(24px, 2.8vw, 32px); line-height: 1.2; letter-spacing: -0.025em; }
  .uni { color: var(--text-2); margin: 0; }
  .honors { list-style: none; margin: 4px 0 8px; padding: 0; display: grid; gap: 8px; }
  .honors li { display: flex; align-items: center; gap: 12px; font-weight: 550; }
  .more { margin-top: 6px; font-size: 14.5px; color: var(--text-2); }
  .more:hover { color: var(--teal); }
  .more span { color: var(--teal); }
  .honors li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 4px color-mix(in srgb, var(--teal) 20%, transparent); }

  .roles { list-style: none; margin: 0; padding: 0; }
  .roles > li { display: grid; grid-template-columns: 200px 1fr; gap: 12px 32px; padding: 30px 0; border-bottom: 1px solid var(--border); }
  .roles > li:first-child { padding-top: 4px; }
  .when { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  .roles h3 { font-size: 21px; letter-spacing: -0.015em; line-height: 1.3; }
  .roles h3 a span { color: var(--teal); }
  .roles h3 a:hover { color: var(--teal); }
  .note { color: var(--muted); margin: 6px 0 14px; font-size: 15.5px; }
  .body { color: var(--text-2); margin: 10px 0 0; font-size: 16px; max-width: 820px; }
  .roles ul { margin: 0; padding-left: 1.1em; max-width: 860px; color: var(--text-2); font-size: 16px; }
  .roles ul li { margin: 0.5em 0; }
  .roles ul li::marker { color: var(--teal); }
  .roles ul strong { color: var(--text); font-weight: 600; }
  .stack { margin: 12px 0 0; font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); }

  @media (max-width: 860px) {
    .edu { grid-template-columns: 1fr; }
    .gpa { border-right: 0; border-bottom: 1px solid var(--border); }
    .roles > li { grid-template-columns: 1fr; }
  }
</style>
