---
import Base from '../layouts/Base.astro';
import CourseMap from '../components/CourseMap.astro';
import { courses, otherCourses, summary, termGpa, termShort, tracks } from '../data/courses';

const id = (code: string) => code.toLowerCase().replace(/\s+/g, '-');
const byTrack = (t: string) => courses.filter((c) => c.track === t);
const deans = termGpa.filter((t) => t.deansList).length;
const regular = termGpa.filter((t) => !t.term.startsWith('Summer')).length;
---

<Base title="Coursework" description="Every course from Vinith Ramaswamy's two degrees at UW–Madison, grouped by track, with grades and the skills each one taught.">
  <section class="top">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow" data-reveal>Coursework</span>
      <h1 data-reveal style="--d:80ms">Two degrees in three years, course by course.</h1>
      <p class="intro" data-reveal style="--d:160ms">
        Everything on my UW–Madison transcript, Aug 2023 to May 2026: what each class covered, what I took from it, and
        the grade. The map shows how the courses build on each other; the sections below go through each track.
      </p>
      <dl class="stats" data-reveal style="--d:220ms">
        <div><dt>Cumulative GPA</dt><dd>{summary.gpa}<span> / 4.0</span></dd></div>
        <div><dt>Credits</dt><dd>{summary.credits}<span> incl. {summary.transferCredits} transfer</span></dd></div>
        <div><dt>Dean's List</dt><dd>{deans}<span> of {regular} semesters</span></dd></div>
        <div><dt>Conferred</dt><dd class="small">{summary.degrees.join(' · ')}<span>{summary.conferred} · {summary.honors}</span></dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="label" data-reveal>The map</h2>
      <CourseMap />
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <h2 class="label" data-reveal>Semester by semester</h2>
      <ol class="terms" data-reveal>
        {termGpa.map((t) => (
          <li>
            <div class="barwrap" role="img" aria-label={`${t.term}: GPA ${t.gpa.toFixed(2)}, ${t.credits} credits`}>
              <i style={`--h:${((t.gpa - 3.5) / 0.5) * 100}%`}></i>
            </div>
            <strong>{t.gpa.toFixed(t.gpa === 4 ? 1 : 3)}</strong>
            <span class="t">{termShort[t.term]}</span>
            <span class="cr">{t.credits} cr{t.deansList ? " · Dean's List" : ''}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {tracks.map((t) => (
    <section class="section tight" id={t.id}>
      <div class="wrap">
        <h2 class={`label tone-${t.tone}`} data-reveal>{t.label}</h2>
        <p class="blurb" data-reveal>{t.blurb}</p>
        <div class="cards">
          {byTrack(t.id).map((c) => (
            <article class={`card tone-${t.tone}`} id={id(c.code)} data-reveal>
              <header>
                <div class="head">
                  <span class="code">{c.code}</span>
                  <h3>{c.title}</h3>
                  <p class="meta">{c.term === 'Transfer' ? 'Transfer credit' : c.term} · {c.credits} credits{c.honors ? ` · ${c.honors}` : ''}</p>
                </div>
                <span class:list={['grade', `g-${c.grade}`]} title={c.grade === 'T' ? 'Transfer credit, no grade' : `Grade: ${c.grade}`}>{c.grade}</span>
              </header>
              <p class="about">{c.about}</p>
              <ul class="chips">{c.skills.map((s) => <li>{s}</li>)}</ul>
              {c.used && (
                <p class="used">
                  Where it shows up:
                  {c.used.map((u, i) => (
                    <><a href={u.href} target={u.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{u.label}</a>{i < c.used!.length - 1 ? ', ' : ''}</>
                  ))}
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section tight last">
    <div class="wrap">
      <h2 class="label" data-reveal>Also on the transcript</h2>
      <p class="blurb" data-reveal>General education, electives and transfer credit.</p>
      <table class="other" data-reveal>
        <thead><tr><th>Course</th><th>Title</th><th>Term</th><th>Credits</th><th>Grade</th></tr></thead>
        <tbody>
          {otherCourses.map((c) => (
            <tr><td class="mono">{c.code}</td><td>{c.title}</td><td>{c.term === 'Transfer' ? 'Transfer' : termShort[c.term]}</td><td>{c.credits}</td><td><span class:list={['grade', `g-${c.grade}`]}>{c.grade}</span></td></tr>
          ))}
        </tbody>
      </table>
      <p class="fine">Grades are from the official transcript (printed Sept 2026). Course descriptions are paraphrased from the UW–Madison Guide; the skills lists are mine.</p>
    </div>
  </section>
</Base>

<style>
  .top { position: relative; padding: clamp(130px, 17vw, 190px) 0 clamp(44px, 6vw, 72px); overflow: hidden; border-bottom: 1px solid var(--border); }
  .glow { position: absolute; inset: -30% -10% auto; height: 120%; background: radial-gradient(640px 360px at 20% 40%, color-mix(in srgb, var(--violet) 12%, transparent), transparent 70%); pointer-events: none; }
  .top .wrap { position: relative; }
  h1 { font-size: clamp(38px, 6vw, 72px); letter-spacing: -0.04em; margin: 22px 0 26px; max-width: 900px; }
  .intro { max-width: 720px; font-size: 18.5px; color: var(--text-2); margin: 0; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin: 36px 0 0; }
  .stats div { padding: 18px 20px; border: 1px solid var(--border); border-radius: 16px; background: var(--bg-raise); }
  .stats dt { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .stats dd { margin: 8px 0 0; font-family: var(--font-display); font-size: 34px; font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .stats dd span { display: block; margin-top: 8px; font-family: var(--font-body); font-size: 13.5px; font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .stats dd.small { font-size: 17px; line-height: 1.35; letter-spacing: -0.01em; }

  .section.tight { padding-top: 0; }
  .section.last { padding-bottom: clamp(72px, 10vw, 128px); }
  .label { font-family: var(--font-mono); font-size: 13px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); margin-bottom: 22px; display: flex; align-items: center; gap: 14px; }
  .label::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .blurb { color: var(--text-2); max-width: 720px; margin: -6px 0 24px; font-size: 16.5px; }

  .tone-teal { --c: var(--teal); }
  .tone-amber { --c: var(--amber); }
  .tone-violet { --c: var(--violet); }
  .tone-blue { --c: #5aa9ff; }
  .tone-rose { --c: #ff7ab6; }
  .tone-muted { --c: var(--muted); }
  :global(:root[data-theme='light']) .tone-blue { --c: #1d6fd1; }
  :global(:root[data-theme='light']) .tone-rose { --c: #c2367b; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .tone-blue { --c: #1d6fd1; }
    :global(:root:not([data-theme='dark'])) .tone-rose { --c: #c2367b; }
  }
  .label.tone-amber, .label.tone-violet, .label.tone-blue, .label.tone-rose, .label.tone-muted { color: var(--c); }

  .terms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; }
  .terms li { display: grid; gap: 6px; text-align: center; }
  .barwrap { height: 110px; border-radius: 10px; background: var(--surface-2); display: flex; align-items: flex-end; overflow: hidden; border: 1px solid var(--border); }
  .barwrap i { display: block; width: 100%; height: var(--h); border-radius: 10px 10px 0 0; background: linear-gradient(180deg, var(--teal), color-mix(in srgb, var(--teal) 55%, var(--violet))); transform-origin: bottom; animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rise { from { transform: scaleY(0); } }
  .terms strong { font-family: var(--font-display); font-size: 20px; letter-spacing: -0.02em; }
  .terms .t { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .terms .cr { font-size: 12px; color: var(--muted); }
  @media (max-width: 760px) { .terms { grid-template-columns: repeat(4, 1fr); } }

  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; margin-bottom: clamp(40px, 6vw, 64px); }
  .card { display: flex; flex-direction: column; gap: 14px; padding: 22px; border: 1px solid var(--border); border-left: 3px solid var(--c); border-radius: 16px; background: var(--bg-raise); box-shadow: var(--shadow); scroll-margin-top: 90px; }
  .card header { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; }
  .card .code { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--c); }
  .card h3 { font-size: 18.5px; line-height: 1.25; letter-spacing: -0.015em; margin: 4px 0 6px; }
  .meta { margin: 0; font-size: 13px; color: var(--muted); }
  .grade { flex: none; display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 30px; padding: 0 10px; border-radius: 99px; font-family: var(--font-mono); font-weight: 600; font-size: 13px; background: color-mix(in srgb, var(--teal) 18%, transparent); color: var(--text); }
  .grade.g-AB { background: color-mix(in srgb, var(--amber) 20%, transparent); }
  .grade.g-T { background: color-mix(in srgb, var(--muted) 22%, transparent); }
  .about { margin: 0; color: var(--text-2); font-size: 15px; line-height: 1.55; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { padding: 4px 10px; border-radius: 99px; border: 1px solid var(--border-strong); background: var(--surface); font-size: 12.5px; color: var(--text); }
  .used { margin: 0; font-size: 13.5px; color: var(--muted); }
  .used a { color: var(--text); border-bottom: 1px solid var(--c); margin-left: 4px; }

  .other { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .other th { text-align: left; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-weight: 500; padding: 0 12px 10px 0; border-bottom: 1px solid var(--border); }
  .other td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--border); color: var(--text-2); vertical-align: middle; }
  .other .mono { font-family: var(--font-mono); font-size: 13px; color: var(--text); white-space: nowrap; }
  .other .grade { height: 24px; min-width: 34px; font-size: 12px; }
  .fine { margin-top: 24px; font-size: 13px; color: var(--muted); }
  @media (max-width: 640px) { .other th:nth-child(3), .other td:nth-child(3), .other th:nth-child(4), .other td:nth-child(4) { display: none; } }
</style>
