---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap nf">
    <span class="eyebrow">404</span>
    <h1>No driver found for that route.</h1>
    <p>The page you asked for doesn't exist.</p>
    <a class="btn primary" href="/">Back home <span class="arrow" aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .nf { min-height: 80vh; display: grid; align-content: center; justify-items: start; gap: 18px; padding-top: 120px; }
  h1 { font-size: clamp(36px, 6vw, 68px); letter-spacing: -0.04em; }
  p { color: var(--text-2); }
</style>
