---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StackChips from '../../components/StackChips.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const toc = headings.filter((h) => h.depth === 2);
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((p) => p.id === project.id) + 1) % all.length];
const d = project.data;
---

<Base title={d.title} description={d.summary}>
  <article class={`accent-${d.accent}`}>
    <header class="head">
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap">
        <a href="/#work" class="back"><span aria-hidden="true">←</span> All work</a>
        <h1 transition:name={`title-${project.id}`}>{d.title}</h1>
        <p class="tagline">{d.tagline}</p>
        <dl class="meta">
          <div><dt>Role</dt><dd>{d.role}</dd></div>
          <div><dt>When</dt><dd>{d.period}</dd></div>
          {d.status && <div><dt>Status</dt><dd><i class="dot"></i>{d.status}</dd></div>}
        </dl>
        <StackChips items={d.stack} />
        {d.links.length > 0 && (
          <div class="links">
            {d.links.map((l, i) => (
              <a class:list={['btn', { primary: i === 0 }]} href={l.href} target="_blank" rel="noopener">
                {l.label} <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="wrap body">
      <aside class="toc" aria-label="On this page">
        <span>On this page</span>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}
        </ol>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <div class="wrap">
      <a class="next" href={`/projects/${next.id}/`}>
        <span class="eyebrow">Next project</span>
        <strong>{next.data.title} <span aria-hidden="true">→</span></strong>
        <span class="sub">{next.data.tagline}</span>
      </a>
    </div>
  </article>
</Base>

<script>
  const spy = () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
    if (!links.length) return;
    const map = new Map(links.map((l) => [l.dataset.toc!, l]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l) => l.classList.remove('on'));
          map.get(e.target.id)?.classList.add('on');
        }
      },
      { rootMargin: '-15% 0px -70% 0px' },
    );
    document.querySelectorAll('.prose h2[id]').forEach((h) => io.observe(h));
  };
  document.addEventListener('astro:page-load', spy);
</script>

<style>
  .accent-teal { --accent: var(--teal); }
  .accent-amber { --accent: var(--amber); }
  .accent-violet { --accent: var(--violet); }

  .head { position: relative; padding: clamp(120px, 16vw, 176px) 0 clamp(40px, 6vw, 64px); overflow: hidden; border-bottom: 1px solid var(--border); }
  .glow {
    position: absolute;
    inset: -40% -10% auto -10%;
    height: 140%;
    background:
      radial-gradient(640px 360px at 18% 40%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(520px 300px at 85% 20%, color-mix(in srgb, var(--violet) 9%, transparent), transparent 70%);
    pointer-events: none;
  }
  .head .wrap { position: relative; }
  .back { font-size: 14px; color: var(--muted); display: inline-flex; gap: 8px; margin-bottom: 28px; transition: color 0.15s; }
  .back:hover { color: var(--text); }
  h1 { font-size: clamp(44px, 8vw, 92px); letter-spacing: -0.04em; }
  .tagline { font-size: clamp(19px, 2.3vw, 25px); color: var(--text-2); max-width: 760px; margin: 22px 0 34px; line-height: 1.45; }
  .meta { display: flex; flex-wrap: wrap; gap: 14px 48px; margin: 0 0 26px; }
  .meta dt { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .meta dd { margin: 0; font-weight: 550; display: flex; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 4px color-mix(in srgb, var(--teal) 22%, transparent); }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .links .primary { background: var(--accent); border-color: var(--accent); }

  .body { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: clamp(32px, 6vw, 88px); padding-top: clamp(48px, 7vw, 88px); padding-bottom: clamp(64px, 8vw, 104px); }
  .body > * { min-width: 0; }
  .toc { position: sticky; top: 104px; align-self: start; font-size: 14px; }
  .toc > span { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .toc ol { list-style: none; padding: 0; margin: 14px 0 0; border-left: 1px solid var(--border); }
  .toc a { display: block; padding: 6px 0 6px 16px; margin-left: -1px; border-left: 1px solid transparent; color: var(--muted); transition: color 0.15s, border-color 0.15s; }
  .toc a:hover { color: var(--text); }
  .toc a:global(.on) { color: var(--text); border-left-color: var(--accent); }
  .prose :global(.credit) { margin-top: 3.5em; padding-top: 1.6em; border-top: 1px solid var(--border); font-size: 14.5px; color: var(--muted); }

  @media (max-width: 900px) {
    .body { grid-template-columns: minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (min-width: 901px) {
    /* let wide figures use the space to the right of the text column */
    .prose :global(.wide) { width: min(100%, 1040px); max-width: none; }
    .prose { max-width: none; }
    .prose > :global(:not(.wide)) { max-width: 720px; }
  }

  .next {
    display: grid;
    gap: 8px;
    padding: clamp(28px, 4vw, 44px);
    margin-bottom: clamp(64px, 8vw, 104px);
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--bg-raise);
    transition: border-color 0.2s, transform 0.2s;
  }
  .next:hover { border-color: var(--accent); transform: translateY(-2px); }
  .next strong { font-family: var(--font-display); font-size: clamp(28px, 4vw, 42px); letter-spacing: -0.03em; }
  .next .sub { color: var(--text-2); }
</style>
