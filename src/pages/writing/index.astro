---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('writing', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Writing" description="Technical writing by Vinith Ramaswamy.">
  <section class="wrap page">
    <span class="eyebrow">Writing</span>
    <h1>Notes from building things.</h1>
    {posts.length === 0 ? (
      <p class="empty">First posts are on the way.</p>
    ) : (
      <ul>
        {posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}/`}>
              <span class="date">{fmt(p.data.date)}</span>
              <strong>{p.data.title}</strong>
              <span class="desc">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .page { padding: clamp(130px, 17vw, 190px) 0 clamp(72px, 10vw, 120px); }
  h1 { font-size: clamp(38px, 6vw, 72px); letter-spacing: -0.04em; margin: 22px 0 48px; }
  ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border); max-width: 820px; }
  li a { display: grid; gap: 6px; padding: 28px 0; border-bottom: 1px solid var(--border); transition: padding 0.2s ease; }
  li a:hover { padding-left: 10px; }
  .date { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); }
  strong { font-family: var(--font-display); font-size: 26px; letter-spacing: -0.02em; }
  .desc, .empty { color: var(--text-2); }
</style>
