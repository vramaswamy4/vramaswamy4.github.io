---
import ArchDiagram from '../ArchDiagram.astro';
import type { DNode, DEdge } from '../ArchDiagram.astro';

const nodes: DNode[] = [
  { id: 'app', label: 'Driver app', sub: 'or fleet simulator', x: 20, y: 56, w: 160, h: 58, kind: 'client' },
  { id: 'gw', label: 'API gateway', x: 250, y: 56, w: 150, h: 58 },
  { id: 'kafka', label: 'Kafka', sub: 'driver.locations · key = driver ID', x: 470, y: 50, w: 250, h: 70, kind: 'broker' },
  { id: 'loc', label: 'Location consumer', sub: 'idempotent writes', x: 800, y: 20, w: 180, h: 58 },
  { id: 'redis', label: 'Redis', sub: 'geo set + last-seen set', x: 800, y: 148, w: 180, h: 54, kind: 'store' },
  { id: 'drv', label: 'Driver service', sub: 'any replica can match', x: 800, y: 272, w: 180, h: 58 },
  { id: 'ops', label: 'Ops map', sub: 'live dots · heatmap · replay', x: 215, y: 266, w: 220, h: 58, kind: 'client' },
];
const edges: DEdge[] = [
  { from: 'app', to: 'gw', tone: 'teal', label: 'positions', lo: [0, -13] },
  { from: 'gw', to: 'kafka', tone: 'violet', label: 'produce', lo: [0, -13] },
  { from: 'kafka', to: 'loc', tone: 'violet', fp: 0.35 },
  { from: 'loc', to: 'redis', tone: 'violet', label: 'GEOADD', lo: [38, 0] },
  { from: 'drv', to: 'redis', tone: 'teal', label: 'GEOSEARCH', lo: [48, 0] },
  { from: 'kafka', to: 'gw', fs: 'b', ts: 'b', fp: 0.3, tp: 0.75, k: 90, tone: 'violet', label: 'fan-out · replay by timestamp', lo: [40, 12] },
  { from: 'gw', to: 'ops', fs: 'b', ts: 't', fp: 0.3, tp: 0.42, tone: 'teal', label: 'WebSocket', lo: [-44, 0] },
];
---

<ArchDiagram
  title="Flagdown location pipeline: driver positions go through the gateway into a Kafka topic keyed by driver ID. A consumer maintains a Redis geo index that the driver service queries for the nearest driver, while the gateway fans the same stream out to the ops map and replays it by timestamp."
  width={1000}
  height={350}
  nodes={nodes}
  edges={edges}
  legend={[
    { tone: 'violet', label: 'position stream' },
    { tone: 'teal', label: 'request / response' },
  ]}
/>
