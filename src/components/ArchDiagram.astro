---
// Data-driven architecture diagram rendered as themed SVG with animated flows.
type Side = 'l' | 'r' | 't' | 'b';
export interface DNode {
  id: string;
  label: string;
  sub?: string;
  x: number;
  y: number;
  w?: number;
  h?: number;
  kind?: 'service' | 'store' | 'broker' | 'client' | 'external' | 'obs' | 'ghost';
  vertical?: boolean;
}
export interface DEdge {
  from: string;
  to: string;
  label?: string;
  tone?: 'teal' | 'amber' | 'violet' | 'muted';
  dashed?: boolean;
  fs?: Side;
  ts?: Side;
  lo?: [number, number]; // label offset
  reverse?: boolean; // animate flow backwards (for replies)
  both?: boolean; // arrowheads on both ends
  fp?: number; // position along the 'from' side, 0..1
  tp?: number;
  k?: number; // curvature override
}
interface Props {
  nodes: DNode[];
  edges: DEdge[];
  width: number;
  height: number;
  title: string;
  groups?: { label: string; x: number; y: number; w: number; h: number }[];
  legend?: { tone: 'teal' | 'amber' | 'violet' | 'muted'; label: string }[];
}
const { nodes, edges, width, height, title, groups = [], legend = [] } = Astro.props;

const N = new Map(nodes.map((n) => [n.id, { w: 150, h: 54, kind: 'service' as const, ...n }]));
const anchor = (n: Required<Pick<DNode, 'x' | 'y' | 'w' | 'h'>>, s: Side, p = 0.5) =>
  s === 'l' ? [n.x, n.y + n.h * p] : s === 'r' ? [n.x + n.w, n.y + n.h * p] : s === 't' ? [n.x + n.w * p, n.y] : [n.x + n.w * p, n.y + n.h];
const normal: Record<Side, [number, number]> = { l: [-1, 0], r: [1, 0], t: [0, -1], b: [0, 1] };

const paths = edges.map((e) => {
  const a = N.get(e.from)!, b = N.get(e.to)!;
  const dx = b.x + b.w / 2 - (a.x + a.w / 2), dy = b.y + b.h / 2 - (a.y + a.h / 2);
  const horiz = Math.abs(dx) >= Math.abs(dy);
  const fs: Side = e.fs ?? (horiz ? (dx > 0 ? 'r' : 'l') : dy > 0 ? 'b' : 't');
  const ts: Side = e.ts ?? (horiz ? (dx > 0 ? 'l' : 'r') : dy > 0 ? 't' : 'b');
  const [x1, y1] = anchor(a, fs, e.fp), [x2, y2] = anchor(b, ts, e.tp);
  const k = e.k ?? Math.max(24, Math.hypot(x2 - x1, y2 - y1) * 0.42);
  const c1 = [x1 + normal[fs][0] * k, y1 + normal[fs][1] * k];
  const c2 = [x2 + normal[ts][0] * k, y2 + normal[ts][1] * k];
  const d = `M${x1},${y1} C${c1[0]},${c1[1]} ${c2[0]},${c2[1]} ${x2},${y2}`;
  const mx = 0.125 * x1 + 0.375 * c1[0] + 0.375 * c2[0] + 0.125 * x2 + (e.lo?.[0] ?? 0);
  const my = 0.125 * y1 + 0.375 * c1[1] + 0.375 * c2[1] + 0.125 * y2 + (e.lo?.[1] ?? 0);
  return { ...e, d, mx, my, tone: e.tone ?? 'muted' };
});
---

<figure class="arch wide" data-reveal>
  <div class="scroll">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title} style={`min-width:${Math.round(width * 0.72)}px;aspect-ratio:${width}/${height}`}>
      <defs>
        {['teal', 'amber', 'violet', 'muted'].map((t) => (
          <marker id={`arr-${t}`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1,1.5 L8.5,5 L1,8.5" fill="none" class={`tone-${t}`} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </marker>
        ))}
      </defs>

      {groups.map((g) => (
        <g class="group">
          <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="16" />
          <text x={g.x + 16} y={g.y + 24}>{g.label}</text>
        </g>
      ))}

      {paths.map((p) => (
        <g class={`edge tone-${p.tone}`}>
          <path d={p.d} class="line" stroke-dasharray={p.dashed ? '5 6' : undefined} marker-end={`url(#arr-${p.tone})`} marker-start={p.both ? `url(#arr-${p.tone})` : undefined} />
          {!p.dashed && <path d={p.d} class:list={['flow', { rev: p.reverse }]} />}
        </g>
      ))}
      {paths.filter((p) => p.label).map((p) => (
        <text class={`elabel tone-${p.tone}`} x={p.mx} y={p.my} text-anchor="middle" dominant-baseline="middle">{p.label}</text>
      ))}

      {[...N.values()].filter((n) => n.kind !== 'ghost').map((n) => (
        <g class={`node k-${n.kind}`} transform={`translate(${n.x},${n.y})`}>
          <rect width={n.w} height={n.h} rx={n.kind === 'store' ? 8 : n.kind === 'broker' ? 27 : 12} />
          {n.kind === 'service' && <rect class="bar" x="0" y="12" width="3" height={n.h - 24} rx="1.5" />}
          <text class="label" x={n.w / 2} y={n.sub && !n.vertical ? n.h / 2 - 6 : n.h / 2 + 1} text-anchor="middle" dominant-baseline="middle" transform={n.vertical ? `rotate(-90 ${n.w / 2} ${n.h / 2})` : undefined}>{n.label}</text>
          {n.sub && !n.vertical && <text class="sub" x={n.w / 2} y={n.h / 2 + 12} text-anchor="middle" dominant-baseline="middle">{n.sub}</text>}
        </g>
      ))}
    </svg>
  </div>
  <p class="hint" aria-hidden="true">Scroll sideways for the full diagram →</p>
  {legend.length > 0 && (
    <figcaption>
      {legend.map((l) => (
        <span class={`tone-${l.tone}`}><i></i>{l.label}</span>
      ))}
    </figcaption>
  )}
</figure>

<style>
  .arch {
    margin: 2.2em 0;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(700px 300px at 80% 0%, color-mix(in srgb, var(--teal) 6%, transparent), transparent 70%),
      var(--bg-raise);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .scroll { overflow-x: auto; padding: clamp(12px, 2.5vw, 28px); }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-body); }

  .group rect { fill: color-mix(in srgb, var(--surface-2) 45%, transparent); stroke: var(--border); stroke-dasharray: 3 5; }
  .group text { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; fill: var(--muted); }

  .tone-teal { stroke: var(--teal); color: var(--teal); }
  .tone-amber { stroke: var(--amber); color: var(--amber); }
  .tone-violet { stroke: var(--violet); color: var(--violet); }
  .tone-muted { stroke: var(--muted); color: var(--muted); }

  .edge .line { fill: none; stroke-width: 1.4; opacity: 0.55; }
  .edge .flow {
    fill: none;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 1 22;
    animation: flow 1.5s linear infinite;
  }
  .edge .flow.rev { animation-direction: reverse; }
  @keyframes flow { to { stroke-dashoffset: -23; } }

  .elabel {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: currentColor;
    stroke: var(--bg-raise);
    stroke-width: 6px;
    paint-order: stroke;
    stroke-linejoin: round;
  }

  .node rect { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1; }
  .node .bar { fill: var(--teal); stroke: none; }
  .node .label { font-family: var(--font-display); font-size: 14.5px; font-weight: 600; fill: var(--text); }
  .node .sub { font-family: var(--font-mono); font-size: 10.5px; fill: var(--muted); }
  .k-broker rect { stroke: var(--amber); fill: color-mix(in srgb, var(--amber) 8%, var(--surface)); }
  .k-store rect { stroke: var(--violet); fill: color-mix(in srgb, var(--violet) 8%, var(--surface)); }
  .k-client rect { fill: var(--surface-2); }
  .k-external rect { stroke-dasharray: 4 4; fill: transparent; }
  .k-obs rect { fill: transparent; stroke: var(--border); }

  .hint { display: none; margin: 0; padding: 0 16px 12px; font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); }
  @media (max-width: 760px) { .hint { display: block; } }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding: 14px clamp(16px, 2.5vw, 28px);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  figcaption span { display: inline-flex; align-items: center; gap: 8px; stroke: none; }
  figcaption i { width: 18px; height: 2px; background: currentColor; border-radius: 2px; }
</style>
