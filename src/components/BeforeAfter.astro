---
// Two same-size screenshots stacked; drag the divider to reveal one or the other.
// A native range input does the dragging, so mouse, touch and keyboard all work and screen
// readers announce it. Without JavaScript it sits at 50/50.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel: string;
  afterLabel: string;
  beforeAlt: string;
  afterAlt: string;
  url?: string;
  caption?: string;
}
const { before, after, beforeLabel, afterLabel, beforeAlt, afterAlt, url, caption } = Astro.props;
---

<figure class="compare" data-reveal>
  <div class="frame">
    <div class="chrome"><i></i><i></i><i></i>{url && <span>{url}</span>}</div>
    <div class="stage" style="--pos: 50%">
      <Image class="img before" src={before} alt={beforeAlt} widths={[720, 1200, 1800]} sizes="(max-width: 1100px) 100vw, 1040px" />
      <div class="after-clip">
        <Image class="img after" src={after} alt={afterAlt} widths={[720, 1200, 1800]} sizes="(max-width: 1100px) 100vw, 1040px" />
      </div>
      <span class="tag tag-before">← {beforeLabel}</span>
      <span class="tag tag-after">{afterLabel} →</span>
      <div class="divider" aria-hidden="true"><span class="knob"><svg viewBox="0 0 24 24"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" /></svg></span></div>
      <input class="range" type="range" min="0" max="100" value="50" aria-label={`Divider between the ${beforeLabel} and ${afterLabel} screenshots`} />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.compare .stage').forEach((stage) => {
    const range = stage.querySelector<HTMLInputElement>('.range');
    if (!range) return;
    const update = () => stage.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', update);
    update();
  });
</script>

<style>
  .compare { margin: 2.2em 0; }
  .frame {
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .chrome i { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .chrome span {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 12px;
  }
  .stage { position: relative; line-height: 0; user-select: none; touch-action: pan-y; }
  .stage :global(.img) { width: 100%; height: auto; display: block; }
  .after-clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25), 0 0 18px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }
  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.35);
  }
  .knob svg { width: 22px; height: 22px; fill: none; stroke: #1d1a2b; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .tag {
    position: absolute;
    top: 14px;
    padding: 5px 12px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: #fff;
    background: rgb(15 13 24 / 0.78);
    backdrop-filter: blur(6px);
    pointer-events: none;
  }
  .tag-before { left: 14px; }
  .tag-after { right: 14px; background: color-mix(in srgb, var(--violet) 85%, black); }
  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .stage:has(.range:focus-visible) .knob { outline: 3px solid var(--violet); outline-offset: 3px; }
  figcaption { margin-top: 12px; font-size: 14px; color: var(--muted); text-align: center; }
</style>
