---
interface Props { items: { value: string; label: string }[]; wide?: boolean }
const { items, wide = true } = Astro.props;
---

<dl class:list={['stats', { wide }]}>
  {items.map((s, i) => (
    <div data-reveal style={`--d:${i * 50}ms`}>
      <dt>{s.label}</dt>
      <dd>{s.value}</dd>
    </div>
  ))}
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 2em 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--border);
  }
  div { background: var(--bg-raise); padding: 22px 22px 20px; display: flex; flex-direction: column-reverse; gap: 4px; }
  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1.1;
  }
  @media (max-width: 640px) { .stats { grid-template-columns: 1fr 1fr; } }
  dt { font-size: 13.5px; color: var(--muted); line-height: 1.4; }
</style>
