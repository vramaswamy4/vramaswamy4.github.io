---
// Card artwork for ride-dispatch: a looping radius search on a street grid, pure SVG + CSS.
const cols = 13, rows = 8, s = 50;
const drivers = [
  [2, 1], [5, 1], [10, 2], [1, 4], [4, 5], [8, 6], [11, 5], [6, 3], [12, 1], [3, 7], [9, 0],
];
const req = [7, 4];
const hit = [6, 3];
---

<svg class="mv" viewBox={`0 0 ${cols * s} ${rows * s}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <g class="roads">
    {Array.from({ length: cols + 1 }, (_, i) => <line x1={i * s} y1="0" x2={i * s} y2={rows * s} class={i % 4 === 2 ? 'av' : ''} />)}
    {Array.from({ length: rows + 1 }, (_, i) => <line x1="0" y1={i * s} x2={cols * s} y2={i * s} class={i % 3 === 1 ? 'av' : ''} />)}
  </g>
  <circle class="ring" cx={req[0] * s} cy={req[1] * s} r="10" />
  <circle class="ring r2" cx={req[0] * s} cy={req[1] * s} r="10" />
  <path class="route" d={`M${hit[0] * s},${hit[1] * s} H${req[0] * s} V${req[1] * s}`} />
  {drivers.map(([x, y], i) => (
    <circle class:list={['drv', { hit: x === hit[0] && y === hit[1] }]} cx={x * s} cy={y * s} r="4" style={`--i:${i}`} />
  ))}
  <circle class="req" cx={req[0] * s} cy={req[1] * s} r="5.5" />
</svg>

<style>
  .mv { width: 100%; height: 100%; display: block; }
  .roads line { stroke: color-mix(in srgb, var(--text) 7%, transparent); stroke-width: 1; }
  .roads .av { stroke: color-mix(in srgb, var(--text) 13%, transparent); stroke-width: 1.6; }
  .drv { fill: var(--teal); animation: bob 4s ease-in-out infinite; animation-delay: calc(var(--i) * -0.37s); }
  .drv.hit { animation: hit 4s ease-in-out infinite; }
  .req { fill: var(--amber); }
  .ring { fill: color-mix(in srgb, var(--amber) 10%, transparent); stroke: var(--amber); stroke-width: 1.2; vector-effect: non-scaling-stroke; transform-box: fill-box; transform-origin: center; animation: ring 4s ease-out infinite; }
  .ring.r2 { animation-delay: -2s; }
  .route { fill: none; stroke: var(--teal); stroke-width: 2; stroke-dasharray: 4 7; stroke-linecap: round; animation: dash 1.2s linear infinite; opacity: 0.8; }
  @keyframes ring { 0% { transform: scale(0.4); opacity: 0.9; } 100% { transform: scale(9); opacity: 0; } }
  @keyframes bob { 50% { opacity: 0.45; } }
  @keyframes hit { 0%, 100% { r: 4; } 50% { r: 7; fill: var(--text); } }
  @keyframes dash { to { stroke-dashoffset: -22; } }
</style>
